# --- environment and secrets ---
# Never commit env values. The variables themselves are documented in the
# README; nothing in this repo should carry a project id, key or token.
.env
.env.*
*.env
secrets/
*-key.json
*credentials*.json
service-account*.json

# --- submission materials ---
# Scripts, decks, videos and exported PDFs are deliverables, not source.
# They live outside the repo. Architecture diagrams are the exception:
# they document the system and belong here, under docs/.
/submission/
/deliverables/
/scripts/
*.pptx
*.potx
*.key
*.pdf
*.mp4
*.mov
*.m4v
*.webm

# --- firebase ---
# firebase.json (hosting rules) IS source and stays. These are not:
# .firebase/ is a local deploy cache, and .firebaserc only names which
# project to deploy to - a deployment value, like GOOGLE_CLOUD_PROJECT.
.firebase/
.firebaserc

# --- tooling and local state ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.idea/
.vscode/
*.log

# Agent and editor config, not source. This was kept out of the repo by a
# local .git/info/exclude, which is not committed - so the rule only existed
# on one machine and a fresh clone would have re-added the file on the next
# `git add -A`. Rules that matter belong where they travel.
.claude/

# --- os cruft ---
.DS_Store
Thumbs.db
desktop.ini
