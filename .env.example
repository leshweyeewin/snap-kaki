# Copy to .env for local runs. Cloud Run gets these via --set-env-vars.

# Offline demo: no Gemini calls, no Firestore. Everything still walks the
# full CHAS flow including the gate. Start here.
USE_STUB=true

GOOGLE_CLOUD_PROJECT=deskpilot-507116
GOOGLE_CLOUD_LOCATION=asia-southeast1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

GEMINI_MODEL=gemini-2.5-flash
EMBED_MODEL=text-embedding-004

# Below this, the gate refuses to give a next step.
CONFIDENCE_FLOOR=0.75

DEFAULT_LANGUAGE=en
