rules_version = '2';

// SnapKaki denies all client access to Firestore, deliberately and totally.
//
// This is not a placeholder to tighten later. Nothing in the product needs
// client access: the browser talks only to the FastAPI service on Cloud
// Run, which reaches Firestore with the Admin SDK under its own service
// account. No Firebase SDK is loaded in the page, no API key is shipped to
// it, and there is no signed-in user for a rule to key off.
//
// So the correct rule is the closed one. A permissive rule here would not
// enable any feature; it would only create a way to read the session
// collection from outside the service.
//
// Note the Admin SDK bypasses these rules entirely, which is why the app
// keeps working with everything denied. That is the intended arrangement:
// the service is the only path in, and it is the thing holding the
// credentials.
//
// Deploy:  firebase deploy --only firestore:rules --project <project-id>

service cloud.firestore {
  match /databases/{database}/documents {

    // form_guidance - the RAG corpus. Read server-side during retrieval,
    // written only by `python -m app.rag.ingest`. No client reads it.
    // sessions      - form structure and progress. No values are stored in
    //                 here (see app/session.py), but it is still nobody
    //                 else's business.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
